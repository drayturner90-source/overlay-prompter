<?xml version="1.0" encoding="utf-8"?>
<!-- The floating prompter window. Background tint is set in code from the opacity setting. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Control bar: drag the ⠿ grip to move the window -->
        <LinearLayout
            android:id="@+id/bar"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="#99000000"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/grip"
                style="@style/OverlayButton"
                android:text="⠿" />

            <TextView
                android:id="@+id/play"
                style="@style/OverlayButton"
                android:text="▶" />

            <TextView
                android:id="@+id/restart"
                style="@style/OverlayButton"
                android:text="⟲" />

            <TextView
                android:id="@+id/slower"
                style="@style/OverlayButton"
                android:text="🐢" />

            <TextView
                android:id="@+id/faster"
                style="@style/OverlayButton"
                android:text="🐇" />

            <TextView
                android:id="@+id/smaller"
                style="@style/OverlayButton"
                android:text="A−" />

            <TextView
                android:id="@+id/bigger"
                style="@style/OverlayButton"
                android:text="A+" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/close"
                style="@style/OverlayButton"
                android:text="✕" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fadingEdgeLength="24dp"
            android:requiresFadingEdge="vertical"
            android:scrollbars="none">

            <TextView
                android:id="@+id/text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.15"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:shadowColor="#FF000000"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="6"
                android:textColor="#FFFFFFFF"
                android:textStyle="bold" />
        </ScrollView>
    </LinearLayout>

    <!-- Drag the corner to resize -->
    <TextView
        android:id="@+id/resize"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="bottom|end"
        android:gravity="center"
        android:text="◢"
        android:textColor="#CCFFFFFF"
        android:textSize="20sp" />
</FrameLayout>
